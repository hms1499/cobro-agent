# OS
.DS_Store

# Dependencies
node_modules/

# Next.js / build output
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment and secrets
# .env is committed: it holds only public NEXT_PUBLIC_* values so a clean clone builds.
# Secrets go in .env.local, which overrides it.
.env.*
!.env.example

# Vercel
.vercel

# Loops House event skill (regenerated by `npx loopshouse add agents-on-open-rails`)
.claude/skills/loops-*/
.agents/

# Tooling
coverage/
.playwright-mcp/
*.log

# Demo video: kept locally, shared by link (YouTube/Loom)
docs/demo/*.mp4
